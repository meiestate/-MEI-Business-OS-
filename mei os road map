        }}
      >
        <input
          value={search}
          onChange={(e) => setSearch(e.target.value)}
          placeholder="Search by name, phone, location, source, owner, status..."
          style={fullInputStyle}
        />

        <select
          value={ownerFilter}
          onChange={(e) => setOwnerFilter(e.target.value as "All" | LeadOwner)}
          style={inputStyle}
        >
          <option value="All">All Owners</option>
          {OWNERS.map((item) => (
            <option key={item} value={item}>
              {item}
            </option>
          ))}
        </select>
      </div>

      {showForm && (
        <div
          style={{
            background: "#111827",
            border: "1px solid #1f2937",
            borderRadius: "18px",
            padding: "20px",
            marginBottom: "20px",
          }}
        >
          <div
            style={{
              fontSize: "22px",
              fontWeight: 700,
              color: "#f8fafc",
              marginBottom: "10px",
            }}
          >
            {editingLeadId !== null ? "Edit Lead" : "Add Lead"}
          </div>

          {editingLeadId === null && (
            <div
              style={{
                background: "#0f172a",
                border: "1px solid #1e293b",
                color: "#93c5fd",
                borderRadius: "12px",
                padding: "12px 14px",
                marginBottom: "16px",
                fontSize: "14px",
              }}
            >
              New lead save ஆனவுடன் owner auto assign ஆகும்.
            </div>
          )}

          <div
            style={{
              display: "grid",
              gridTemplateColumns: "repeat(2, minmax(0, 1fr))",
              gap: "16px",
            }}
          >
            <input
              value={name}
              onChange={(e) => setName(e.target.value)}
              placeholder="Lead name"
              style={inputStyle}
            />

            <input
              value={phone}
              onChange={(e) => setPhone(e.target.value)}
              placeholder="Phone number"
              style={inputStyle}
            />

            <input
              value={location}
              onChange={(e) => setLocation(e.target.value)}
              placeholder="Location"
              style={inputStyle}
            />

            <select
              value={source}
              onChange={(e) => setSource(e.target.value as LeadSource)}
              style={inputStyle}
            >
              <option value="Website">Website</option>
              <option value="WhatsApp">WhatsApp</option>
              <option value="Broker">Broker</option>
              <option value="Referral">Referral</option>
              <option value="Facebook Ads">Facebook Ads</option>
              <option value="Magicbricks">Magicbricks</option>
              <option value="99acres">99acres</option>
              <option value="Walk-in">Walk-in</option>
            </select>

            {editingLeadId !== null ? (
              <select
                value={owner}
                onChange={(e) => setOwner(e.target.value as LeadOwner)}
                style={inputStyle}
              >
                {OWNERS.map((item) => (
                  <option key={item} value={item}>
                    {item}
                  </option>
                ))}
              </select>
            ) : (
              <input
                value={`Auto Assign → ${getNextOwner(leads)}`}
                readOnly
                style={{
                  ...inputStyle,
                  opacity: 0.9,
                  background: "#111827",
                  color: "#93c5fd",
                }}
              />
            )}

            <select
              value={status}
              onChange={(e) => setStatus(e.target.value as LeadStatus)}
              style={inputStyle}
            >
              <option value="New">New</option>
              <option value="Follow-up">Follow-up</option>
              <option value="Visit Planned">Visit Planned</option>
              <option value="Closed">Closed</option>
            </select>

            <input
              value={dealValue}
              onChange={(e) => setDealValue(e.target.value)}
              placeholder="Deal value (example: 4500000)"
              style={inputStyle}
            />

            <input
              type="date"
              value={followUpDate}
              onChange={(e) => setFollowUpDate(e.target.value)}
              style={inputStyle}
            />
          </div>

          <div
            style={{
              display: "flex",
              gap: "12px",
              marginTop: "18px",
            }}
          >
            <button onClick={handleSaveLead} style={primaryButtonStyle}>
              {editingLeadId !== null ? "Update Lead" : "Save Lead"}
            </button>

            <button onClick={closeForm} style={secondaryButtonStyle}>
              Cancel
            </button>
          </div>
        </div>
      )}

      <div
        style={{
          background: "#111827",
          border: "1px solid #1f2937",
          borderRadius: "18px",
          overflow: "hidden",
        }}
      >
        <div
          style={{
            display: "grid",
            gridTemplateColumns: "1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 260px",
            gap: "12px",
            padding: "16px 18px",
            borderBottom: "1px solid #1f2937",
            color: "#94a3b8",
            fontWeight: 700,
          }}
        >
          <div>Name</div>
          <div>Phone</div>
          <div>Location</div>
          <div>Source</div>
          <div>Owner</div>
          <div>Status</div>
          <div>Deal Value</div>
          <div>Follow-up</div>
          <div>Created</div>
          <div>Action</div>
        </div>

        {filteredLeads.length === 0 ? (
          <div
            style={{
              padding: "30px 18px",
              color: "#94a3b8",
            }}
          >
            No leads found.
          </div>
        ) : (
          filteredLeads.map((lead) => (
            <div
              key={lead.id}
              style={{
                display: "grid",
                gridTemplateColumns: "1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 260px",
                gap: "12px",
                padding: "16px 18px",
                borderBottom: "1px solid #1f2937",
                alignItems: "center",
                background: isOverdue(lead.followUpDate, lead.status)
                  ? "rgba(127, 29, 29, 0.14)"
                  : "transparent",
              }}
            >
              <div style={{ color: "#f8fafc", fontWeight: 600 }}>{lead.name}</div>
              <div>{lead.phone}</div>
              <div>{lead.location}</div>
              <div>{lead.source}</div>

              <div>
                <select
                  value={lead.owner}
                  onChange={(e) =>
                    handleInlineOwnerChange(lead.id, e.target.value as LeadOwner)
                  }
                  style={{
                    background: getOwnerColor(lead.owner),
                    color: "white",
                    border: "none",
                    borderRadius: "999px",
                    padding: "8px 12px",
                    fontSize: "12px",
                    fontWeight: 700,
                    outline: "none",
                    cursor: "pointer",
                  }}
                >
                  {OWNERS.map((item) => (
                    <option key={item} value={item}>
                      {item}
                    </option>
                  ))}
                </select>
              </div>

              <div>
                <select
                  value={lead.status}
                  onChange={(e) =>
                    handleInlineStatusChange(lead.id, e.target.value as LeadStatus)
                  }
                  style={{
                    background: getStatusColor(lead.status),
                    color: "white",
                    border: "none",
                    borderRadius: "999px",
                    padding: "8px 12px",
                    fontSize: "12px",
                    fontWeight: 700,
                    outline: "none",
                    cursor: "pointer",
                  }}
                >
                  <option value="New">New</option>
                  <option value="Follow-up">Follow-up</option>
                  <option value="Visit Planned">Visit Planned</option>
                  <option value="Closed">Closed</option>
                </select>
              </div>

              <div>₹ {formatIndianCurrency(lead.dealValue)}</div>

              <div
                style={{
                  color: isOverdue(lead.followUpDate, lead.status)
                    ? "#f87171"
                    : "#e5e7eb",
                  fontWeight: isOverdue(lead.followUpDate, lead.status) ? 700 : 500,
                }}
              >
                {lead.followUpDate}
              </div>

              <div>{lead.createdAt}</div>

              <div style={{ display: "flex", gap: "8px", flexWrap: "wrap" }}>
                <button
                  onClick={() => callLead(lead.phone)}
                  style={callButtonStyle}
                >
                  Call
                </button>

                <button
                  onClick={() => openWhatsApp(lead.phone, lead.name)}
                  style={whatsAppButtonStyle}
                >
                  WhatsApp
                </button>

                <button
                  onClick={() => openEditForm(lead)}
                  style={editButtonStyle}
                >
                  Edit
                </button>

                <button
                  onClick={() => handleDeleteLead(lead.id)}
                  style={deleteButtonStyle}
                >
                  Delete
                </button>
              </div>
            </div>
          ))
        )}
      </div>
    </div>
  );
}

