import { useEffect, useMemo, useState } from "react";

type LeadStatus = "New" | "Follow-up" | "Visit Planned" | "Closed";

type Lead = {
  id: number;
  name: string;
  phone: string;
  location: string;
  status: LeadStatus;
  dealValue: string;
  followUpDate: string;
  createdAt: string;
};

const STORAGE_KEY = "mei_crm_leads";

export default function DashboardPage() {
  const [leads, setLeads] = useState<Lead[]>([]);

  useEffect(() => {
    loadLeads();

    const interval = setInterval(() => {
      loadLeads();
    }, 500);

    return () => clearInterval(interval);
  }, []);

  function loadLeads() {
    const saved = localStorage.getItem(STORAGE_KEY);
    const parsed = saved ? JSON.parse(saved) : [];
    setLeads(parsed);
  }

  const stats = useMemo(() => {
    const today = new Date().toISOString().slice(0, 10);

    return {
      total: leads.length,
      new: leads.filter((l) => l.status === "New").length,
      followUp: leads.filter((l) => l.status === "Follow-up").length,
      visit: leads.filter((l) => l.status === "Visit Planned").length,
      closed: leads.filter((l) => l.status === "Closed").length,
      overdue: leads.filter(
        (l) =>
          l.followUpDate &&
          l.followUpDate < today &&
          l.status !== "Closed"
      ).length,
      pipelineValue: leads.reduce(
        (sum, lead) => sum + Number(lead.dealValue || 0),
        0
      ),
      closedValue: leads
        .filter((l) => l.status === "Closed")
        .reduce((sum, lead) => sum + Number(lead.dealValue || 0), 0),
    };
  }, [leads]);

  function formatCurrency(value: number) {
    return new Intl.NumberFormat("en-IN").format(value);
  }

  return (
    <div>
      <h1 style={{ color: "white", marginBottom: "20px" }}>Dashboard</h1>

      <div
        style={{
          display: "grid",
          gridTemplateColumns: "repeat(5, 1fr)",
          gap: "20px",
          marginBottom: "30px",
        }}
      >
        <Card title="Total Leads" value={stats.total} />
        <Card title="Follow-ups Due" value={stats.followUp} />
        <Card title="Visit Planned" value={stats.visit} />
        <Card title="Closed Leads" value={stats.closed} />
        <Card
          title="Overdue Follow-ups"
          value={stats.overdue}
          danger={stats.overdue > 0}
        />
      </div>

      <div
        style={{
          display: "grid",
          gridTemplateColumns: "repeat(2, 1fr)",
          gap: "20px",
        }}
      >
        <Card
          title="Pipeline Value"
          value={`₹ ${formatCurrency(stats.pipelineValue)}`}
        />

        <Card
          title="Closed Revenue"
          value={`₹ ${formatCurrency(stats.closedValue)}`}
        />
      </div>

      <div
        style={{
          marginTop: "30px",
          background: "#111827",
          padding: "20px",
          borderRadius: "18px",
          border: "1px solid #1f2937",
        }}
      >
        <h2 style={{ color: "white", marginBottom: "16px" }}>
          Pipeline Overview
        </h2>

        <PipelineRow label="New" value={stats.new} />
        <PipelineRow label="Follow-up" value={stats.followUp} />
        <PipelineRow label="Visit Planned" value={stats.visit} />
        <PipelineRow label="Closed" value={stats.closed} />
      </div>
    </div>
  );
}

function Card({
  title,
  value,
  danger = false,
}: {
  title: string;
  value: string | number;
  danger?: boolean;
}) {
  return (
    <div
      style={{
        background: "#111827",
        border: `1px solid ${danger ? "#7f1d1d" : "#1f2937"}`,
        borderRadius: "18px",
        padding: "24px",
        boxShadow: danger ? "0 0 0 1px rgba(239,68,68,0.15)" : "none",
      }}
    >
      <div style={{ color: "#94a3b8", marginBottom: "10px" }}>{title}</div>
      <div
        style={{
          color: danger ? "#f87171" : "white",
          fontSize: "40px",
          fontWeight: 700,
        }}
      >
        {value}
      </div>
    </div>
  );
}

function PipelineRow({
  label,
  value,
}: {
  label: string;
  value: number;
}) {
  return (
    <div
      style={{
        display: "flex",
        justifyContent: "space-between",
        padding: "14px 0",
        borderBottom: "1px solid #1f2937",
        color: "white",
      }}
    >
      <span>{label}</span>
      <span>{value}</span>
    </div>
  );
}
