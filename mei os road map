        {title}
      </div>

      <div
        style={{
          fontSize: "30px",
          fontWeight: 800,
          color: danger ? "#f87171" : "#f8fafc",
        }}
      >
        {value}
      </div>
    </div>
  );
}

function PipelineRow({
  label,
  value,
}: {
  label: string;
  value: number;
}) {
  return (
    <div
      style={{
        display: "flex",
        justifyContent: "space-between",
        padding: "14px 0",
