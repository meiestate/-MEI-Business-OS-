import { useEffect, useMemo, useState } from "react";

type LeadStatus = "New" | "Follow-up" | "Visit Planned" | "Closed";

type Lead = {
  id: number;
  name: string;
  phone: string;
  location: string;
  status: LeadStatus;
  dealValue: string;
  followUpDate: string;
  createdAt: string;
};

const STORAGE_KEY = "mei_crm_leads";

const defaultLeads: Lead[] = [
  {
    id: 1,
    name: "Arun Kumar",
    phone: "9876543210",
    location: "Whitefield",
    status: "New",
    dealValue: "4500000",
    followUpDate: "2026-03-30",
    createdAt: "2026-03-28",
  },
  {
    id: 2,
    name: "Priya",
    phone: "9123456780",
    location: "Sarjapur",
    status: "Follow-up",
    dealValue: "8200000",
    followUpDate: "2026-03-31",
    createdAt: "2026-03-28",
  },
];

export default function LeadsPage() {
  const [leads, setLeads] = useState<Lead[]>([]);
  const [search, setSearch] = useState("");
  const [showForm, setShowForm] = useState(false);
  const [editingLeadId, setEditingLeadId] = useState<number | null>(null);

  const [name, setName] = useState("");
  const [phone, setPhone] = useState("");
  const [location, setLocation] = useState("");
  const [status, setStatus] = useState<LeadStatus>("New");
  const [dealValue, setDealValue] = useState("");
  const [followUpDate, setFollowUpDate] = useState("");

  useEffect(() => {
    const savedLeads = localStorage.getItem(STORAGE_KEY);

    if (savedLeads) {
      setLeads(JSON.parse(savedLeads));
    } else {
      setLeads(defaultLeads);
      localStorage.setItem(STORAGE_KEY, JSON.stringify(defaultLeads));
    }
  }, []);

  useEffect(() => {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(leads));
  }, [leads]);

  const filteredLeads = useMemo(() => {
    const q = search.toLowerCase().trim();

    return leads.filter((lead) => {
      return (
        lead.name.toLowerCase().includes(q) ||
        lead.phone.toLowerCase().includes(q) ||
        lead.location.toLowerCase().includes(q) ||
        lead.status.toLowerCase().includes(q) ||
        lead.dealValue.toLowerCase().includes(q) ||
        lead.followUpDate.toLowerCase().includes(q)
      );
    });
  }, [leads, search]);

  function resetForm() {
    setName("");
    setPhone("");
    setLocation("");
    setStatus("New");
    setDealValue("");
    setFollowUpDate("");
    setEditingLeadId(null);
  }

  function openAddForm() {
    resetForm();
    setShowForm(true);
  }

  function openEditForm(lead: Lead) {
    setName(lead.name);
    setPhone(lead.phone);
    setLocation(lead.location);
    setStatus(lead.status);
    setDealValue(lead.dealValue);
    setFollowUpDate(lead.followUpDate);
    setEditingLeadId(lead.id);
    setShowForm(true);
  }

  function closeForm() {
    resetForm();
    setShowForm(false);
  }

  function handleSaveLead() {
    if (
      !name.trim() ||
      !phone.trim() ||
      !location.trim() ||
      !dealValue.trim() ||
      !followUpDate.trim()
    ) {
      alert("Please fill all fields");
      return;
    }

    if (editingLeadId !== null) {
      setLeads((prev) =>
        prev.map((lead) =>
          lead.id === editingLeadId
            ? {
                ...lead,
                name: name.trim(),
                phone: phone.trim(),
                location: location.trim(),
                status,
                dealValue: dealValue.trim(),
                followUpDate,
              }
            : lead
        )
      );
    } else {
      const newLead: Lead = {
        id: Date.now(),
        name: name.trim(),
        phone: phone.trim(),
        location: location.trim(),
        status,
        dealValue: dealValue.trim(),
        followUpDate,
        createdAt: new Date().toISOString().slice(0, 10),
      };

      setLeads((prev) => [newLead, ...prev]);
    }

    setSearch("");
    closeForm();
  }

  function handleDeleteLead(id: number) {
    const ok = confirm("Are you sure you want to delete this lead?");
    if (!ok) return;

    setLeads((prev) => prev.filter((lead) => lead.id !== id));

    if (editingLeadId === id) {
      closeForm();
    }
  }

  function handleInlineStatusChange(id: number, newStatus: LeadStatus) {
    setLeads((prev) =>
      prev.map((lead) =>
        lead.id === id ? { ...lead, status: newStatus } : lead
      )
    );
  }

  function getStatusColor(leadStatus: LeadStatus) {
    if (leadStatus === "New") return "#2563eb";
    if (leadStatus === "Follow-up") return "#f59e0b";
    if (leadStatus === "Visit Planned") return "#8b5cf6";
    if (leadStatus === "Closed") return "#16a34a";
    return "#475569";
  }

  function formatIndianCurrency(value: string) {
    const num = Number(value);
    if (Number.isNaN(num)) return value;

    return new Intl.NumberFormat("en-IN", {
      maximumFractionDigits: 0,
    }).format(num);
  }

  function isOverdue(date: string) {
    if (!date) return false;
    const today = new Date().toISOString().slice(0, 10);
    return date < today;
  }

  return (
    <div>
      <div
        style={{
          display: "flex",
          justifyContent: "space-between",
          alignItems: "center",
          marginBottom: "20px",
          gap: "16px",
          flexWrap: "wrap",
        }}
      >
        <div>
          <div style={{ fontSize: "18px", color: "#94a3b8", marginBottom: "6px" }}>
            Leads Management
          </div>
          <div style={{ fontSize: "32px", fontWeight: 800, color: "#f8fafc" }}>
            All Leads
          </div>
        </div>

        <button onClick={openAddForm} style={primaryButtonStyle}>
          + Add New Lead
        </button>
      </div>

      <div
        style={{
          background: "#111827",
          border: "1px solid #1f2937",
          borderRadius: "18px",
          padding: "18px",
          marginBottom: "20px",
        }}
      >
        <input
          value={search}
          onChange={(e) => setSearch(e.target.value)}
          placeholder="Search by name, phone, location, status, value..."
          style={fullInputStyle}
        />
      </div>

      {showForm && (
        <div
          style={{
            background: "#111827",
            border: "1px solid #1f2937",
            borderRadius: "18px",
            padding: "20px",
            marginBottom: "20px",
          }}
        >
          <div
            style={{
              fontSize: "22px",
              fontWeight: 700,
              color: "#f8fafc",
              marginBottom: "16px",
            }}
          >
            {editingLeadId !== null ? "Edit Lead" : "Add Lead"}
          </div>

          <div
            style={{
              display: "grid",
              gridTemplateColumns: "repeat(2, minmax(0, 1fr))",
              gap: "16px",
            }}
          >
            <input
              value={name}
              onChange={(e) => setName(e.target.value)}
              placeholder="Lead name"
              style={inputStyle}
            />

            <input
              value={phone}
              onChange={(e) => setPhone(e.target.value)}
              placeholder="Phone number"
              style={inputStyle}
            />

            <input
              value={location}
              onChange={(e) => setLocation(e.target.value)}
              placeholder="Location"
              style={inputStyle}
            />

            <select
              value={status}
              onChange={(e) => setStatus(e.target.value as LeadStatus)}
              style={inputStyle}
            >
              <option value="New">New</option>
              <option value="Follow-up">Follow-up</option>
              <option value="Visit Planned">Visit Planned</option>
              <option value="Closed">Closed</option>
            </select>

            <input
              value={dealValue}
              onChange={(e) => setDealValue(e.target.value)}
              placeholder="Deal value (example: 4500000)"
              style={inputStyle}
            />

            <input
              type="date"
              value={followUpDate}
              onChange={(e) => setFollowUpDate(e.target.value)}
              style={inputStyle}
            />
          </div>

          <div
            style={{
              display: "flex",
              gap: "12px",
              marginTop: "18px",
            }}
          >
            <button onClick={handleSaveLead} style={primaryButtonStyle}>
              {editingLeadId !== null ? "Update Lead" : "Save Lead"}
            </button>

            <button onClick={closeForm} style={secondaryButtonStyle}>
              Cancel
            </button>
          </div>
        </div>
      )}

      <div
        style={{
          background: "#111827",
          border: "1px solid #1f2937",
          borderRadius: "18px",
          overflow: "hidden",
        }}
      >
        <div
          style={{
            display: "grid",
            gridTemplateColumns: "1fr 1fr 1fr 1fr 1fr 1fr 1fr 160px",
            gap: "12px",
            padding: "16px 18px",
            borderBottom: "1px solid #1f2937",
            color: "#94a3b8",
            fontWeight: 700,
          }}
        >
          <div>Name</div>
          <div>Phone</div>
          <div>Location</div>
          <div>Status</div>
          <div>Deal Value</div>
          <div>Follow-up</div>
          <div>Created</div>
          <div>Action</div>
        </div>

        {filteredLeads.length === 0 ? (
          <div
            style={{
              padding: "30px 18px",
              color: "#94a3b8",
            }}
          >
            No leads found.
          </div>
        ) : (
          filteredLeads.map((lead) => (
            <div
              key={lead.id}
              style={{
                display: "grid",
                gridTemplateColumns: "1fr 1fr 1fr 1fr 1fr 1fr 1fr 160px",
                gap: "12px",
                padding: "16px 18px",
                borderBottom: "1px solid #1f2937",
                alignItems: "center",
              }}
            >
              <div style={{ color: "#f8fafc", fontWeight: 600 }}>{lead.name}</div>
              <div>{lead.phone}</div>
              <div>{lead.location}</div>

              <div>
                <select
                  value={lead.status}
                  onChange={(e) =>
                    handleInlineStatusChange(lead.id, e.target.value as LeadStatus)
                  }
                  style={{
                    background: getStatusColor(lead.status),
                    color: "white",
                    border: "none",
                    borderRadius: "999px",
                    padding: "8px 12px",
                    fontSize: "12px",
                    fontWeight: 700,
                    outline: "none",
                    cursor: "pointer",
