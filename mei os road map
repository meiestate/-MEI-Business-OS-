  }

  function openOwnerWhatsAppAlert(ownerName: LeadOwner, lead: Lead) {
    if (ownerName === "Unassigned") return;

    const ownerPhone = OWNER_PHONE_MAP[ownerName];
    if (!ownerPhone) return;

    const message = encodeURIComponent(
      `Hi ${ownerName},

New lead assigned to you 🚀

Name: ${lead.name}
Phone: ${lead.phone}
Location: ${lead.location}
Source: ${lead.source}
Status: ${lead.status}
Deal Value: ₹ ${formatIndianCurrency(lead.dealValue)}
Follow-up Date: ${lead.followUpDate}

Please contact the lead as soon as possible.
- MEI Business OS`
    );

    window.open(`https://wa.me/${ownerPhone}?text=${message}`, "_blank");
  }

  function callLead(phone: string) {
    window.location.href = `tel:${phone}`;
  }

  function exportCSV() {
    if (leads.length === 0) {
      alert("No leads to export");
      return;
    }

    const headers = [
      "Name",
      "Phone",
      "Location",
      "Source",
