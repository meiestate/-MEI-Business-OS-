import { useEffect, useMemo, useState } from "react";
import { useLocation } from "react-router-dom";

type LeadStatus = "New" | "Follow-up" | "Visit Planned" | "Closed";

type LeadSource =
  | "Website"
  | "WhatsApp"
  | "Broker"
  | "Referral"
  | "Facebook Ads"
  | "Magicbricks"
  | "99acres"
  | "Walk-in";

type LeadOwner =
  | "Unassigned"
  | "Admin"
  | "Ravi"
  | "Suresh"
  | "Kumar"
  | "Meena"
  | "Sabari"
  | "Team A"
  | "Team B";

type Lead = {
  id: number;
  name: string;
  phone: string;
  location: string;
  source: LeadSource;
  owner: LeadOwner;
  status: LeadStatus;
  dealValue: string;
  followUpDate: string;
  createdAt: string;
};

const STORAGE_KEY = "mei_crm_leads";

const OWNERS: LeadOwner[] = [
  "Unassigned",
  "Admin",
  "Ravi",
  "Suresh",
  "Kumar",
  "Meena",
  "Sabari",
  "Team A",
  "Team B",
];

const AUTO_ASSIGN_OWNERS: LeadOwner[] = [
  "Admin",
  "Ravi",
  "Suresh",
  "Kumar",
  "Meena",
  "Sabari",
  "Team A",
  "Team B",
];

const defaultLeads: Lead[] = [
  {
    id: 1,
    name: "Arun Kumar",
    phone: "9876543210",
    location: "Whitefield",
    source: "Website",
    owner: "Admin",
    status: "New",
    dealValue: "4500000",
    followUpDate: "2026-03-30",
    createdAt: "2026-03-28",
  },
  {
    id: 2,
    name: "Priya",
    phone: "9123456780",
    location: "Sarjapur",
    source: "Referral",
    owner: "Ravi",
    status: "Follow-up",
    dealValue: "8200000",
    followUpDate: "2026-03-31",
    createdAt: "2026-03-28",
  },
];

function normalizeLead(raw: any): Lead {
  return {
    id: Number(raw?.id ?? Date.now()),
    name: String(raw?.name ?? ""),
    phone: String(raw?.phone ?? ""),
    location: String(raw?.location ?? ""),
    source: (raw?.source as LeadSource) || "Website",
    owner: (raw?.owner as LeadOwner) || "Unassigned",
    status: (raw?.status as LeadStatus) || "New",
    dealValue: String(raw?.dealValue ?? ""),
    followUpDate: String(raw?.followUpDate ?? ""),
    createdAt: String(raw?.createdAt ?? new Date().toISOString().slice(0, 10)),
  };
}

function getInitialLeads(): Lead[] {
  try {
    const saved = localStorage.getItem(STORAGE_KEY);

    if (!saved) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(defaultLeads));
      return defaultLeads;
    }

    const parsed = JSON.parse(saved);

    if (Array.isArray(parsed) && parsed.length > 0) {
      return parsed.map(normalizeLead);
    }

    localStorage.setItem(STORAGE_KEY, JSON.stringify(defaultLeads));
    return defaultLeads;
  } catch {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(defaultLeads));
    return defaultLeads;
  }
}

function getNextOwner(existingLeads: Lead[]): LeadOwner {
  if (AUTO_ASSIGN_OWNERS.length === 0) return "Unassigned";

  const assignedLeads = existingLeads.filter((lead) =>
    AUTO_ASSIGN_OWNERS.includes(lead.owner)
  );

  if (assignedLeads.length === 0) {
    return AUTO_ASSIGN_OWNERS[0];
  }

  const newestLead = assignedLeads[0];
  const currentIndex = AUTO_ASSIGN_OWNERS.indexOf(newestLead.owner);

  if (currentIndex === -1) {
    return AUTO_ASSIGN_OWNERS[0];
  }

  const nextIndex = (currentIndex + 1) % AUTO_ASSIGN_OWNERS.length;
  return AUTO_ASSIGN_OWNERS[nextIndex];
}

