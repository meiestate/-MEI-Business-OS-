              name: name.trim(),
              phone: phone.trim(),
              location: location.trim(),
              source: finalSource,
              owner,
              status,
              dealValue: dealValue.trim(),
              followUpDate,
            }
          : lead
      );

      persist(updated);
    } else {
      const autoAssignedOwner = getNextOwner(leads);

      const newLead: Lead = {
        id: Date.now(),
        name: name.trim(),
        phone: phone.trim(),
        location: location.trim(),
        source: finalSource,
        owner: autoAssignedOwner,
        status,
        dealValue: dealValue.trim(),
        followUpDate,
        createdAt: new Date().toISOString().slice(0, 10),
