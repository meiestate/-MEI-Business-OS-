                border: "1px solid #334155",
                borderRadius: "12px",
                padding: "12px 18px",
                fontWeight: 700,
                cursor: "pointer",
              }}
            >
              Cancel
            </button>
          </div>
        </div>
      )}

      <div
        style={{
          background: "#111827",
          border: "1px solid #1f2937",
          borderRadius: "18px",
          overflow: "hidden",
        }}
      >
        <div
          style={{
            display: "grid",
            gridTemplateColumns: "1.2fr 1fr 1fr 1fr 1fr 100px",
            gap: "12px",
            padding: "16px 18px",
            borderBottom: "1px solid #1f2937",
            color: "#94a3b8",
            fontWeight: 700,
          }}
        >
          <div>Name</div>
          <div>Phone</div>
          <div>Location</div>
          <div>Status</div>
          <div>Created</div>
          <div>Action</div>
        </div>

        {filteredLeads.length === 0 ? (
          <div
            style={{
              padding: "30px 18px",
              color: "#94a3b8",
            }}
          >
            No leads found.
          </div>
        ) : (
          filteredLeads.map((lead) => (
            <div
              key={lead.id}
              style={{
                display: "grid",
                gridTemplateColumns: "1.2fr 1fr 1fr 1fr 1fr 100px",
                gap: "12px",
                padding: "16px 18px",
                borderBottom: "1px solid #1f2937",
                alignItems: "center",
              }}
            >
              <div style={{ color: "#f8fafc", fontWeight: 600 }}>{lead.name}</div>
              <div>{lead.phone}</div>
