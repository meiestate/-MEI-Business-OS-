import { useEffect, useMemo, useState } from "react";

type LeadStatus = "New" | "Follow-up" | "Visit Planned" | "Closed";

type Lead = {
  id: number;
  name: string;
  phone: string;
  location: string;
  status: LeadStatus;
  createdAt: string;
};

const STORAGE_KEY = "mei_crm_leads";

export default function DashboardPage() {
  const [leads, setLeads] = useState<Lead[]>([]);

  useEffect(() => {
    loadLeads();

    const handleStorage = () => {
      loadLeads();
    };

    window.addEventListener("storage", handleStorage);

    const interval = setInterval(() => {
      loadLeads();
    }, 500);

    return () => {
      window.removeEventListener("storage", handleStorage);
      clearInterval(interval);
    };
  }, []);

  function loadLeads() {
    const savedLeads = localStorage.getItem(STORAGE_KEY);
    if (savedLeads) {
      setLeads(JSON.parse(savedLeads));
    } else {
      setLeads([]);
    }
  }

  const stats = useMemo(() => {
    const totalLeads = leads.length;
    const followUps = leads.filter(
      (lead) => lead.status === "Follow-up"
    ).length;
    const visitPlanned = leads.filter(
      (lead) => lead.status === "Visit Planned"
    ).length;
    const closed = leads.filter(
      (lead) => lead.status === "Closed"
    ).length;
    const newLeads = leads.filter(
      (lead) => lead.status === "New"
    ).length;

    return {
      totalLeads,
      followUps,
      visitPlanned,
      closed,
      newLeads,
    };
  }, [leads]);

  const cards = [
    {
      title: "Total Leads",
      value: String(stats.totalLeads),
      sub: `${stats.newLeads} new`,
    },
    {
      title: "Follow-ups Due",
      value: String(stats.followUps),
      sub: `${stats.followUps} active follow-ups`,
    },
    {
      title: "Visit Planned",
      value: String(stats.visitPlanned),
      sub: `${stats.visitPlanned} site visits`,
    },
    {
      title: "Closed Leads",
      value: String(stats.closed),
      sub: `${stats.closed} completed`,
    },
  ];

  const pipelineItems = [
    { label: "New", count: stats.newLeads },
    { label: "Follow-up", count: stats.followUps },
    { label: "Visit Planned", count: stats.visitPlanned },
    { label: "Closed", count: stats.closed },
  ];

  const recentTasks = [
    "Call 3 hot leads",
    "Schedule Whitefield visit",
    "Send price sheet",
    "Update negotiation notes",
  ];

  return (
    <div>
      <div
        style={{
          display: "grid",
          gridTemplateColumns: "repeat(4, minmax(0, 1fr))",
          gap: "16px",
          marginBottom: "24px",
        }}
      >
        {cards.map((card) => (
          <div
            key={card.title}
            style={{
              background: "#111827",
              border: "1px solid #1f2937",
              borderRadius: "18px",
              padding: "20px",
            }}
          >
            <div
              style={{
                fontSize: "14px",
                color: "#94a3b8",
                marginBottom: "10px",
              }}
            >
              {card.title}
            </div>

            <div
              style={{
                fontSize: "32px",
                fontWeight: 800,
                color: "#f8fafc",
              }}
            >
              {card.value}
            </div>

            <div
              style={{
                fontSize: "13px",
                color: "#60a5fa",
                marginTop: "8px",
              }}
            >
              {card.sub}
            </div>
          </div>
        ))}
      </div>

      <div
        style={{
          display: "grid",
