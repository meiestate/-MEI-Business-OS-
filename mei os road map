import { useEffect, useMemo, useState } from "react";

type LeadStatus = "New" | "Follow-up" | "Visit Planned" | "Closed";

type LeadSource =
  | "Website"
  | "WhatsApp"
  | "Broker"
  | "Referral"
  | "Facebook Ads"
  | "Magicbricks"
  | "99acres"
  | "Walk-in";

type LeadOwner =
  | "Unassigned"
  | "Admin"
  | "Ravi"
  | "Suresh"
  | "Kumar"
  | "Meena"
  | "Sabari"
  | "Team A"
  | "Team B";

type Lead = {
  id: number;
  name: string;
  phone: string;
  location: string;
  source: LeadSource;
  owner: LeadOwner;
  status: LeadStatus;
  dealValue: string;
  followUpDate: string;
  createdAt: string;
};

const STORAGE_KEY = "mei_crm_leads";

export default function DashboardPage() {
  const [leads, setLeads] = useState<Lead[]>([]);

  useEffect(() => {
    loadLeads();

    const interval = setInterval(() => {
      loadLeads();
    }, 500);

    return () => clearInterval(interval);
  }, []);

  function loadLeads() {
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      const parsed = saved ? JSON.parse(saved) : [];
      setLeads(Array.isArray(parsed) ? parsed : []);
    } catch {
      setLeads([]);
    }
  }

  const analytics = useMemo(() => {
    const today = new Date().toISOString().slice(0, 10);

    const total = leads.length;
    const newCount = leads.filter((l) => l.status === "New").length;
    const followUp = leads.filter((l) => l.status === "Follow-up").length;
    const visit = leads.filter((l) => l.status === "Visit Planned").length;
    const closed = leads.filter((l) => l.status === "Closed").length;

    const overdue = leads.filter(
      (l) => l.followUpDate && l.followUpDate < today && l.status !== "Closed"
    ).length;

    const pipelineValue = leads.reduce(
      (sum, lead) => sum + Number(lead.dealValue || 0),
      0
    );

    const closedValue = leads
      .filter((l) => l.status === "Closed")
      .reduce((sum, lead) => sum + Number(lead.dealValue || 0), 0);

    const conversionRate =
      total > 0 ? ((closed / total) * 100).toFixed(1) : "0.0";

    const averageDealValue =
      total > 0 ? Math.round(pipelineValue / total) : 0;

    const sourceCounts: Record<LeadSource, number> = {
      Website: 0,
      WhatsApp: 0,
      Broker: 0,
      Referral: 0,
      "Facebook Ads": 0,
      Magicbricks: 0,
      "99acres": 0,
      "Walk-in": 0,
    };

    const ownerCounts: Record<LeadOwner, number> = {
      Unassigned: 0,
      Admin: 0,
      Ravi: 0,
      Suresh: 0,
      Kumar: 0,
      Meena: 0,
      Sabari: 0,
      "Team A": 0,
      "Team B": 0,
    };

    const ownerValueMap: Record<LeadOwner, number> = {
      Unassigned: 0,
      Admin: 0,
      Ravi: 0,
      Suresh: 0,
      Kumar: 0,
      Meena: 0,
      Sabari: 0,
      "Team A": 0,
      "Team B": 0,
    };

    const ownerClosedMap: Record<LeadOwner, number> = {
      Unassigned: 0,
      Admin: 0,
      Ravi: 0,
      Suresh: 0,
      Kumar: 0,
      Meena: 0,
      Sabari: 0,
      "Team A": 0,
      "Team B": 0,
    };

    for (const lead of leads) {
      sourceCounts[lead.source] = (sourceCounts[lead.source] || 0) + 1;
      ownerCounts[lead.owner] = (ownerCounts[lead.owner] || 0) + 1;
      ownerValueMap[lead.owner] =
        (ownerValueMap[lead.owner] || 0) + Number(lead.dealValue || 0);

      if (lead.status === "Closed") {
        ownerClosedMap[lead.owner] = (ownerClosedMap[lead.owner] || 0) + 1;
      }
    }

    const sourceRows = Object.entries(sourceCounts)
      .map(([source, count]) => ({ source, count }))
      .filter((item) => item.count > 0)
      .sort((a, b) => b.count - a.count);

    const ownerRows = Object.entries(ownerCounts)
      .map(([owner, count]) => ({
        owner,
        count,
        value: ownerValueMap[owner as LeadOwner] || 0,
        closed: ownerClosedMap[owner as LeadOwner] || 0,
      }))
      .filter((item) => item.count > 0)
      .sort((a, b) => b.count - a.count);

    const topSource = sourceRows.length > 0 ? sourceRows[0].source : "-";
    const topOwner = ownerRows.length > 0 ? ownerRows[0].owner : "-";

    return {
      total,
      newCount,
      followUp,
      visit,
      closed,
      overdue,
      pipelineValue,
      closedValue,
      conversionRate,
      averageDealValue,
      topSource,
      topOwner,
      sourceRows,
      ownerRows,
    };
  }, [leads]);

  function formatCurrency(value: number) {
    return new Intl.NumberFormat("en-IN").format(value);
  }

  return (
    <div>
      <div
        style={{
          fontSize: "40px",
          fontWeight: 800,
          color: "#f8fafc",
          marginBottom: "24px",
        }}
      >
        Dashboard
      </div>

      <div
        style={{
          display: "grid",
          gridTemplateColumns: "repeat(5, minmax(0, 1fr))",
          gap: "16px",
          marginBottom: "24px",
        }}
      >
        <MetricCard title="Total Leads" value={analytics.total} />
        <MetricCard title="Follow-ups Due" value={analytics.followUp} />
        <MetricCard title="Visit Planned" value={analytics.visit} />
        <MetricCard title="Closed Leads" value={analytics.closed} />
        <MetricCard
          title="Overdue Follow-ups"
          value={analytics.overdue}
          danger={analytics.overdue > 0}
        />
      </div>

      <div
        style={{
          display: "grid",
          gridTemplateColumns: "repeat(4, minmax(0, 1fr))",
          gap: "16px",
          marginBottom: "24px",
        }}
      >
        <MetricCard
          title="Pipeline Value"
          value={`₹ ${formatCurrency(analytics.pipelineValue)}`}
        />
        <MetricCard
          title="Closed Revenue"
          value={`₹ ${formatCurrency(analytics.closedValue)}`}
        />
        <MetricCard
          title="Conversion Rate"
          value={`${analytics.conversionRate}%`}
        />
        <MetricCard
          title="Avg Deal Value"
          value={`₹ ${formatCurrency(analytics.averageDealValue)}`}
        />
      </div>

      <div
        style={{
          display: "grid",
          gridTemplateColumns: "1.2fr 1fr",
          gap: "16px",
          marginBottom: "24px",
        }}
      >
        <section style={panelStyle}>
          <div style={sectionTitleStyle}>Pipeline Overview</div>

          <PipelineRow label="New" value={analytics.newCount} />
          <PipelineRow label="Follow-up" value={analytics.followUp} />
          <PipelineRow label="Visit Planned" value={analytics.visit} />
          <PipelineRow label="Closed" value={analytics.closed} />
        </section>

        <section style={panelStyle}>
          <div style={sectionTitleStyle}>Quick Insights</div>

          <InsightBox label="Top Source" value={analytics.topSource} />
          <InsightBox label="Top Owner" value={analytics.topOwner} />
          <InsightBox
            label="Total Pipeline"
            value={`₹ ${formatCurrency(analytics.pipelineValue)}`}
          />
          <InsightBox
            label="Overdue Count"
            value={String(analytics.overdue)}
            danger={analytics.overdue > 0}
          />
        </section>
      </div>

      <div
        style={{
          display: "grid",
          gridTemplateColumns: "1fr 1fr",
          gap: "16px",
          marginBottom: "24px",
        }}
      >
        <section style={panelStyle}>
          <div style={sectionTitleStyle}>Source Performance</div>

          {analytics.sourceRows.length === 0 ? (
            <div style={{ color: "#94a3b8" }}>No source data available.</div>
          ) : (
            <div style={{ display: "grid", gap: "12px" }}>
              {analytics.sourceRows.map((item) => (
                <SimpleRow
                  key={item.source}
                  label={item.source}
                  value={item.count}
                />
              ))}
            </div>
          )}
        </section>

        <section style={panelStyle}>
          <div style={sectionTitleStyle}>Owner Performance</div>

          {analytics.ownerRows.length === 0 ? (
            <div style={{ color: "#94a3b8" }}>No owner data available.</div>
          ) : (
            <div
              style={{
                display: "grid",
                gap: "12px",
              }}
            >
              {analytics.ownerRows.map((item) => (
                <div
                  key={item.owner}
                  style={{
                    background: "#0f172a",
                    border: "1px solid #1e293b",
                    borderRadius: "14px",
                    padding: "14px 16px",
                    color: "#e5e7eb",
                  }}
                >
                  <div
                    style={{
                      fontWeight: 700,
                      color: "#f8fafc",
                      marginBottom: "10px",
                      fontSize: "16px",
                    }}
                  >
                    {item.owner}
                  </div>

                  <div
                    style={{
                      display: "grid",
                      gridTemplateColumns: "1fr 1fr 1fr",
                      gap: "10px",
                    }}
                  >
                    <MiniStat label="Leads" value={item.count} />
                    <MiniStat
                      label="Value"
                      value={`₹ ${formatCurrency(item.value)}`}
                    />
                    <MiniStat label="Closed" value={item.closed} />
                  </div>
                </div>
              ))}
            </div>
          )}
        </section>
      </div>
    </div>
  );
}

