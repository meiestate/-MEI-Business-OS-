import { useEffect, useMemo, useState } from "react";
import { useLocation } from "react-router-dom";

type LeadStatus = "New" | "Follow-up" | "Visit Planned" | "Closed";

type LeadSource =
  | "Website"
  | "WhatsApp"
  | "Broker"
  | "Referral"
  | "Facebook Ads"
  | "Magicbricks"
  | "99acres"
  | "Walk-in";

type LeadOwner =
  | "Unassigned"
  | "Admin"
  | "Ravi"
  | "Suresh"
  | "Kumar"
  | "Meena"
  | "Sabari"
  | "Team A"
  | "Team B";

type Lead = {
  id: number;
  name: string;
  phone: string;
  location: string;
  source: LeadSource;
  owner: LeadOwner;
  status: LeadStatus;
  dealValue: string;
  followUpDate: string;
  createdAt: string;
};

const STORAGE_KEY = "mei_crm_leads";

const OWNERS: LeadOwner[] = [
  "Unassigned",
  "Admin",
  "Ravi",
  "Suresh",
  "Kumar",
  "Meena",
  "Sabari",
  "Team A",
  "Team B",
];

const defaultLeads: Lead[] = [
  {
    id: 1,
    name: "Arun Kumar",
    phone: "9876543210",
    location: "Whitefield",
    source: "Website",
    owner: "Unassigned",
    status: "New",
    dealValue: "4500000",
    followUpDate: "2026-03-30",
    createdAt: "2026-03-28",
  },
  {
    id: 2,
    name: "Priya",
    phone: "9123456780",
    location: "Sarjapur",
    source: "Referral",
    owner: "Unassigned",
    status: "Follow-up",
    dealValue: "8200000",
    followUpDate: "2026-03-31",
    createdAt: "2026-03-28",
  },
];

function normalizeLead(raw: any): Lead {
  return {
    id: Number(raw?.id ?? Date.now()),
    name: String(raw?.name ?? ""),
    phone: String(raw?.phone ?? ""),
    location: String(raw?.location ?? ""),
    source: (raw?.source as LeadSource) || "Website",
    owner: (raw?.owner as LeadOwner) || "Unassigned",
    status: (raw?.status as LeadStatus) || "New",
    dealValue: String(raw?.dealValue ?? ""),
    followUpDate: String(raw?.followUpDate ?? ""),
    createdAt: String(raw?.createdAt ?? new Date().toISOString().slice(0, 10)),
  };
}

function getInitialLeads(): Lead[] {
  try {
    const saved = localStorage.getItem(STORAGE_KEY);

    if (!saved) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(defaultLeads));
      return defaultLeads;
    }

    const parsed = JSON.parse(saved);

    if (Array.isArray(parsed) && parsed.length > 0) {
      return parsed.map(normalizeLead);
    }

    localStorage.setItem(STORAGE_KEY, JSON.stringify(defaultLeads));
    return defaultLeads;
  } catch {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(defaultLeads));
    return defaultLeads;
  }
}

export default function LeadsPage() {
  const locationHook = useLocation();

  const [leads, setLeads] = useState<Lead[]>(getInitialLeads);
  const [search, setSearch] = useState("");
  const [ownerFilter, setOwnerFilter] = useState<"All" | LeadOwner>("All");
  const [showForm, setShowForm] = useState(false);
  const [editingLeadId, setEditingLeadId] = useState<number | null>(null);
  const [hydrated, setHydrated] = useState(false);

  const [name, setName] = useState("");
  const [phone, setPhone] = useState("");
  const [location, setLocation] = useState("");
  const [source, setSource] = useState<LeadSource>("Website");
  const [owner, setOwner] = useState<LeadOwner>("Unassigned");
  const [status, setStatus] = useState<LeadStatus>("New");
  const [dealValue, setDealValue] = useState("");
  const [followUpDate, setFollowUpDate] = useState("");

  function persist(nextLeads: Lead[]) {
    setLeads(nextLeads);
    localStorage.setItem(STORAGE_KEY, JSON.stringify(nextLeads));
  }

  function resetForm() {
    setName("");
    setPhone("");
    setLocation("");
    setSource("Website");
    setOwner("Unassigned");
    setStatus("New");
    setDealValue("");
    setFollowUpDate("");
    setEditingLeadId(null);
  }

  function openAddForm() {
    resetForm();
    setShowForm(true);
  }

  function openEditForm(lead: Lead) {
    setName(lead.name);
    setPhone(lead.phone);
    setLocation(lead.location);
    setSource(lead.source);
    setOwner(lead.owner);
    setStatus(lead.status);
    setDealValue(lead.dealValue);
    setFollowUpDate(lead.followUpDate);
    setEditingLeadId(lead.id);
    setShowForm(true);
  }

  function closeForm() {
    resetForm();
    setShowForm(false);
  }

  useEffect(() => {
    setHydrated(true);
  }, []);

  useEffect(() => {
    if (!hydrated) return;
    localStorage.setItem(STORAGE_KEY, JSON.stringify(leads));
  }, [leads, hydrated]);

  useEffect(() => {
    const routeState = locationHook.state as { openAddLeadForm?: boolean } | null;

    if (routeState?.openAddLeadForm) {
      resetForm();
      setShowForm(true);
      window.history.replaceState({}, document.title);
    }
  }, [locationHook.state]);

  const filteredLeads = useMemo(() => {
    const q = search.toLowerCase().trim();

    return leads.filter((lead) => {
      const matchesOwner =
        ownerFilter === "All" ? true : lead.owner === ownerFilter;

      const matchesSearch =
        lead.name.toLowerCase().includes(q) ||
        lead.phone.toLowerCase().includes(q) ||
        lead.location.toLowerCase().includes(q) ||
        lead.source.toLowerCase().includes(q) ||
        lead.owner.toLowerCase().includes(q) ||
        lead.status.toLowerCase().includes(q) ||
        lead.dealValue.toLowerCase().includes(q) ||
        lead.followUpDate.toLowerCase().includes(q);

      return matchesOwner && matchesSearch;
    });
  }, [leads, search, ownerFilter]);

  function handleSaveLead() {
    if (
      !name.trim() ||
      !phone.trim() ||
      !location.trim() ||
      !dealValue.trim() ||
      !followUpDate.trim()
    ) {
      alert("Please fill all fields");
      return;
    }

    const finalSource: LeadSource = source || "Website";
    const finalOwner: LeadOwner = owner || "Unassigned";

    if (editingLeadId !== null) {
      const updated = leads.map((lead) =>
        lead.id === editingLeadId
          ? {
              ...lead,
              name: name.trim(),
              phone: phone.trim(),
              location: location.trim(),
              source: finalSource,
              owner: finalOwner,
              status,
              dealValue: dealValue.trim(),
              followUpDate,
            }
          : lead
      );

      persist(updated);
    } else {
      const newLead: Lead = {
        id: Date.now(),
        name: name.trim(),
        phone: phone.trim(),
        location: location.trim(),
        source: finalSource,
        owner: finalOwner,
        status,
        dealValue: dealValue.trim(),
        followUpDate,
        createdAt: new Date().toISOString().slice(0, 10),
      };

      persist([newLead, ...leads]);
    }

    setSearch("");
    closeForm();
  }

  function handleDeleteLead(id: number) {
    const ok = confirm("Are you sure you want to delete this lead?");
    if (!ok) return;

    const updated = leads.filter((lead) => lead.id !== id);
    persist(updated);

    if (editingLeadId === id) {
      closeForm();
    }
  }

  function handleInlineStatusChange(id: number, newStatus: LeadStatus) {
    const updated = leads.map((lead) =>
      lead.id === id ? { ...lead, status: newStatus } : lead
    );
    persist(updated);
  }

  function handleInlineOwnerChange(id: number, newOwner: LeadOwner) {
    const updated = leads.map((lead) =>
      lead.id === id ? { ...lead, owner: newOwner } : lead
    );
    persist(updated);
  }

  function getStatusColor(leadStatus: LeadStatus) {
    if (leadStatus === "New") return "#2563eb";
    if (leadStatus === "Follow-up") return "#f59e0b";
    if (leadStatus === "Visit Planned") return "#8b5cf6";
    if (leadStatus === "Closed") return "#16a34a";
    return "#475569";
  }

  function getOwnerColor(leadOwner: LeadOwner) {
    if (leadOwner === "Admin") return "#1d4ed8";
    if (leadOwner === "Ravi") return "#0f766e";
    if (leadOwner === "Suresh") return "#7c3aed";
