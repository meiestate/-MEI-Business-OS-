                }}
              >
                <span>{label}</span>
                <strong>{count}</strong>
              </div>
            ))}
          </div>
        </section>

        <section
          style={{
            background: "#111827",
            border: "1px solid #1f2937",
            borderRadius: "18px",
            padding: "20px",
          }}
        >
          <div style={{ fontSize: "18px", fontWeight: 700, marginBottom: "16px" }}>
            Today Tasks
          </div>

          <div style={{ display: "grid", gap: "12px" }}>
            {[
              "Call 3 hot leads",
              "Schedule Whitefield visit",
